@model LibraryManagementSystem.Entities.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="text-danger">@ViewData["Title"]</h1>
            <div class="alert alert-danger" role="alert">
                Are you sure you want to delete this book?
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@Model.Title</h5>
                    <p class="card-text">
                        <strong>Price:</strong> $@Model.Price.ToString("F2")<br />
                        <strong>Quantity:</strong> @Model.Quantity<br />
                        <strong>ISBN:</strong> @Model.ISBN
                    </p>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="mt-3">
                <input type="hidden" asp-for="BookId" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
