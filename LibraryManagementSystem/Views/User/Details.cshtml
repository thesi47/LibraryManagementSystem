@model LibraryManagementSystem.Entities.ApplicationUser

@{
    ViewData["Title"] = "User Details";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">

            <h1>@ViewData["Title"]</h1>

            <dl class="row">

                <dt class="col-sm-3">
                    Full Name
                </dt>

                <dd class="col-sm-9">
                    @Model.FullName
                </dd>

                <dt class="col-sm-3">
                    Email
                </dt>

                <dd class="col-sm-9">
                    @Model.Email
                </dd>

                <dt class="col-sm-3">
                    PhoneNumber
                </dt>

                <dd class="col-sm-9">
                    @Model.PhoneNumber
                </dd>

            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>
    </div>
</div>