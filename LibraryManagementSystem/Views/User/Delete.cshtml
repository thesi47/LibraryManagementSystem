@model LibraryManagementSystem.Entities.ApplicationUser

@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">

            <h1 class="text-danger">@ViewData["Title"]</h1>

            <h4>Are you sure you want to delete this user?</h4>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">
                    User Name
                </dt>

                <dd class="col-sm-9">
                    @Model.UserName
                </dd>

                <dt class="col-sm-3">
                    Email
                </dt>

                <dd class="col-sm-9">
                    @Model.Email
                </dd>

                <dt class="col-sm-3">
                    PhoneNumber
                </dt>

                <dd class="col-sm-9">
                    @Model.PhoneNumber
                </dd>

            </dl>

            <form asp-action="Delete">

                <input type="hidden" asp-for="Id" />

                <button class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>